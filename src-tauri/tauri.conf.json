{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Viewer",
  "version": "0.1.0",
  "identifier": "io.github.dsh-mdviewer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markdown Viewer",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Lightweight document viewer",
    "longDescription": "Browse a folder of documents and search their full text, rendered with a comfortable reading typography. Markdown is read as prose; scripts, source, and config files are read as highlighted source.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt", "text", "log", "rst", "adoc", "csv", "tsv"],
        "name": "Text Document",
        "description": "Plain text document",
        "role": "Viewer",
        "mimeType": "text/plain"
      },
      {
        "ext": ["sh", "bash", "zsh", "fish", "ps1", "bat", "cmd", "nu"],
        "name": "Shell Script",
        "description": "Shell script",
        "role": "Viewer",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "js", "mjs", "cjs", "jsx", "ts", "mts", "cts", "tsx", "py", "rb",
          "php", "pl", "lua", "r", "rs", "go", "java", "kt", "scala", "swift",
          "cs", "c", "h", "cc", "cpp", "hpp", "dart", "ex", "erl", "hs", "clj",
          "groovy", "jl", "sql"
        ],
        "name": "Source File",
        "description": "Source code file",
        "role": "Viewer",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "html", "htm", "css", "scss", "sass", "less", "xml", "svg", "json",
          "jsonc", "yaml", "yml", "toml", "ini", "cfg", "conf", "properties",
          "env", "diff", "patch", "tex", "vue", "svelte", "astro"
        ],
        "name": "Config or Markup File",
        "description": "Configuration or markup file",
        "role": "Viewer",
        "mimeType": "text/plain"
      }
    ]
  }
}
